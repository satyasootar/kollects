# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3030
# Required: development | test | production
ENVIRONMENT=development
BACKEND_URL=http://localhost:3030
CLIENT_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml (MONGO_USER / MONGO_PASSWORD)
MONGODB_URI=mongodb://kollects:kollects-local-dev@localhost:27017/kollects?authSource=admin

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# Two different random values, at least 32 chars each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# HMAC key for hashing client IPs (its own random value, never reuse a JWT secret)
IP_HASH_KEY=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Cloudinary (form cover images + file-upload answers) ────────────────────
# Never commit real values. Create a free account at cloudinary.com.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated, verified accounts only. Empty = nobody can reach /api/admin.
ADMIN_EMAILS=
